---
import MainLayout from "@/layouts/MainLayout.astro";
import Section from "@components/Section.astro";
import { SITE } from "@data/constants";
import teams from "@data/teams";
import { Rocket, Users, Lightbulb, Mail, Phone, ChevronRight, Star, Sparkles, Clock, Trophy, Shield, CheckCircle, Zap, Heart } from "lucide-astro";

// Form submits to our API which saves to Supabase
const formAction = "/api/register";

// Get adoptable teams
const adoptableTeams = teams.filter(t => t.isExample);

// Check if a team was pre-selected via query param
const selectedTeamId = Astro.url.searchParams.get('team');
const selectedTeam = selectedTeamId ? teams.find(t => t.id === selectedTeamId) : null;

// Stats for social proof
const totalTeams = teams.length;
const availableForAdoption = adoptableTeams.length;
---

<MainLayout
  title={`Join the Hackathon | ${SITE.title}`}
  customDescription="Register your team for Vibe Code Utah - the AI-powered hackathon building solutions that matter."
>
  <!-- Enhanced Hero Section -->
  <section class="relative py-16 md:py-20 px-4 overflow-hidden bg-gradient-to-b from-neutral-50 to-white dark:from-neutral-900 dark:to-neutral-800">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-5 dark:opacity-10 hero-bg-pattern"></div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- Urgency Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-orange-100 dark:bg-orange-500/20 border border-orange-200 dark:border-orange-500/30 animate-pulse-slow">
        <Clock size={16} class="text-orange-600 dark:text-orange-400" />
        <span class="text-sm font-bold text-orange-700 dark:text-orange-300">Registration Open - Limited Spots</span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-neutral-900 dark:text-white mb-4 tracking-tight">
        Build Something That<br/><span class="text-orange-500">Actually Matters</span>
      </h1>
      <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 mb-8 max-w-2xl mx-auto">
        Join teams creating humanitarian tech that changes lives. No experience required — just heart and hustle.
      </p>

      <!-- Social Proof Stats -->
      <div class="flex flex-wrap justify-center gap-6 md:gap-10 mb-10">
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-black text-orange-500">{availableForAdoption}</div>
          <div class="text-sm text-neutral-500 dark:text-neutral-400 font-medium">Teams to Adopt</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-black text-neutral-900 dark:text-white">15</div>
          <div class="text-sm text-neutral-500 dark:text-neutral-400 font-medium">Days to Build</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-black text-neutral-900 dark:text-white">$5K+</div>
          <div class="text-sm text-neutral-500 dark:text-neutral-400 font-medium">In Prizes</div>
        </div>
      </div>

      <!-- Quick Benefits -->
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300">
          <CheckCircle size={16} class="text-green-500" />
          <span>Free to join</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300">
          <CheckCircle size={16} class="text-green-500" />
          <span>Solo or team</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300">
          <CheckCircle size={16} class="text-green-500" />
          <span>Mentor support</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-600 dark:text-neutral-300">
          <CheckCircle size={16} class="text-green-500" />
          <span>Real impact</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 md:px-8 pb-20 -mt-4">
    <!-- Why Join Cards - Redesigned -->
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <div class="group flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-500/50 hover:shadow-lg transition-all duration-300">
        <div class="shrink-0 w-12 h-12 rounded-xl bg-orange-100 dark:bg-orange-500/20 flex items-center justify-center text-orange-600 dark:text-orange-400 group-hover:scale-110 transition-transform">
          <Zap size={24} />
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 dark:text-white mb-1">AI-Powered</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Use Cursor, Claude, ChatGPT — any tools that help you ship fast</p>
        </div>
      </div>

      <div class="group flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-500/50 hover:shadow-lg transition-all duration-300">
        <div class="shrink-0 w-12 h-12 rounded-xl bg-orange-100 dark:bg-orange-500/20 flex items-center justify-center text-orange-600 dark:text-orange-400 group-hover:scale-110 transition-transform">
          <Users size={24} />
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 dark:text-white mb-1">Any Skill Level</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Beginners welcome. Mentors available to help you succeed</p>
        </div>
      </div>

      <div class="group flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-500/50 hover:shadow-lg transition-all duration-300">
        <div class="shrink-0 w-12 h-12 rounded-xl bg-orange-100 dark:bg-orange-500/20 flex items-center justify-center text-orange-600 dark:text-orange-400 group-hover:scale-110 transition-transform">
          <Heart size={24} />
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 dark:text-white mb-1">Real Impact</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Build software that helps real people with real problems</p>
        </div>
      </div>
    </div>

    <!-- Registration Form -->
    <div class="bg-white dark:bg-neutral-800 rounded-2xl border border-neutral-200 dark:border-neutral-700 shadow-xl overflow-hidden" id="register-form">
      <!-- Form Header - Enhanced -->
      <div class="bg-neutral-900 dark:bg-neutral-950 p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Register Your Team</h2>
            <p class="text-neutral-400">Takes about 2 minutes. We'll send confirmation to your email.</p>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/20 border border-green-500/30">
            <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
            <span class="text-sm font-medium text-green-400">Spots Available</span>
          </div>
        </div>
      </div>

      <!-- Form Body -->
      <form
        action={formAction}
        method="POST"
        class="p-6 md:p-8 space-y-6"
        id="registration-form"
      >
        <!-- Hidden field to identify form type -->
        <input type="hidden" name="_subject" value="New Team Registration - Vibe Code Utah" />
        <input type="hidden" name="adopted-team-id" id="adopted-team-id" value={selectedTeamId || ""} />

        <!-- Team Selection: Adopt or Create - Enhanced -->
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <label class="block text-sm font-bold text-neutral-700 dark:text-neutral-200">
              How would you like to join?
            </label>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Step 1 of 3</span>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <!-- Adopt a Team Option - Recommended -->
            <label
              class={`team-option-card relative flex flex-col p-5 rounded-xl border-2 cursor-pointer transition-all duration-300 ${selectedTeam ? 'border-orange-500 bg-orange-50 dark:bg-orange-500/10 ring-2 ring-orange-500/20' : 'border-neutral-200 dark:border-neutral-600 hover:border-orange-300 dark:hover:border-orange-500/50'}`}
            >
              <input
                type="radio"
                name="join-type"
                value="adopt"
                class="sr-only"
                checked={!!selectedTeam}
                id="join-adopt"
              />
              <!-- Recommended Badge -->
              <div class="absolute -top-3 left-4 px-3 py-1 bg-orange-500 text-white text-xs font-bold rounded-full">
                Recommended
              </div>
              <div class="flex items-center gap-3 mb-3 mt-2">
                <div class="w-12 h-12 rounded-xl bg-orange-500 flex items-center justify-center text-white shadow-lg shadow-orange-500/30">
                  <Star size={24} />
                </div>
                <div>
                  <span class="font-bold text-neutral-900 dark:text-white text-lg">Adopt a Team</span>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-orange-100 dark:bg-orange-500/20 text-orange-600 dark:text-orange-400">
                      {adoptableTeams.length} available
                    </span>
                  </div>
                </div>
              </div>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3">
                Jump in fast with a pre-built idea, name, and project pitch. Just add your team!
              </p>
              <div class="flex items-center gap-2 text-xs text-green-600 dark:text-green-400">
                <CheckCircle size={14} />
                <span>Fastest way to start</span>
              </div>
              <div class="absolute top-5 right-3 w-6 h-6 rounded-full border-2 border-orange-500 flex items-center justify-center check-indicator">
                <div class="w-3 h-3 rounded-full bg-orange-500 scale-0 transition-transform"></div>
              </div>
            </label>

            <!-- Create Your Own Option -->
            <label
              class={`team-option-card relative flex flex-col p-5 rounded-xl border-2 cursor-pointer transition-all duration-300 ${!selectedTeam ? 'border-neutral-300 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-700/50' : 'border-neutral-200 dark:border-neutral-600 hover:border-neutral-400 dark:hover:border-neutral-500'}`}
            >
              <input
                type="radio"
                name="join-type"
                value="create"
                class="sr-only"
                checked={!selectedTeam}
                id="join-create"
              />
              <div class="flex items-center gap-3 mb-3 mt-2">
                <div class="w-12 h-12 rounded-xl bg-neutral-200 dark:bg-neutral-600 flex items-center justify-center text-neutral-600 dark:text-neutral-300">
                  <Sparkles size={24} />
                </div>
                <div>
                  <span class="font-bold text-neutral-900 dark:text-white text-lg">Create Your Own</span>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-xs text-neutral-500 dark:text-neutral-400">
                      Bring your own idea
                    </span>
                  </div>
                </div>
              </div>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3">
                Have a specific project in mind? Start fresh with your own team name and idea.
              </p>
              <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                <Lightbulb size={14} />
                <span>For teams with existing ideas</span>
              </div>
              <div class="absolute top-5 right-3 w-6 h-6 rounded-full border-2 border-neutral-400 dark:border-neutral-500 flex items-center justify-center check-indicator">
                <div class="w-3 h-3 rounded-full bg-neutral-500 scale-0 transition-transform"></div>
              </div>
            </label>
          </div>
        </div>

        <!-- Adopt Team Selector (shown when adopting) - Enhanced with visual cards -->
        <div id="adopt-selector" class={selectedTeam ? '' : 'hidden'}>
          <div class="flex items-center justify-between mb-4">
            <label class="block text-sm font-bold text-neutral-700 dark:text-neutral-200">
              Pick Your Team <span class="text-red-500">*</span>
            </label>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Step 2 of 3</span>
          </div>

          <!-- Visual Team Cards Grid -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-4" id="team-cards-grid">
            {adoptableTeams.map(team => (
              <button
                type="button"
                class={`team-card-select group relative p-3 rounded-xl border-2 transition-all duration-300 text-left ${team.id === selectedTeamId ? 'border-orange-500 bg-orange-50 dark:bg-orange-500/10 ring-2 ring-orange-500/20' : 'border-neutral-200 dark:border-neutral-600 hover:border-orange-300 dark:hover:border-orange-500/50 bg-white dark:bg-neutral-800'}`}
                data-team-id={team.id}
                data-team-name={team.name}
                data-team-pitch={team.elevatorPitch}
                data-team-project={team.projectName}
                data-team-image={team.tokenImage}
                data-team-category={team.category}
              >
                <div class="flex flex-col items-center text-center">
                  <img
                    src={team.tokenImage}
                    alt={team.name}
                    class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover mb-2 ring-2 ring-neutral-200 dark:ring-neutral-600 group-hover:ring-orange-400 transition-all"
                  />
                  <h4 class="font-bold text-xs md:text-sm text-neutral-900 dark:text-white line-clamp-2 leading-tight mb-1">{team.name}</h4>
                  <span class="text-[10px] md:text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300">{team.category}</span>
                </div>
                <!-- Selected checkmark -->
                <div class={`absolute top-2 right-2 w-5 h-5 rounded-full flex items-center justify-center transition-all ${team.id === selectedTeamId ? 'bg-orange-500 text-white' : 'bg-neutral-200 dark:bg-neutral-600 opacity-0 group-hover:opacity-100'}`}>
                  <CheckCircle size={12} />
                </div>
              </button>
            ))}
          </div>

          <!-- Hidden select for form submission -->
          <select
            name="adopt-team"
            id="adopt-team"
            class="sr-only"
          >
            <option value="">Choose a team...</option>
            {adoptableTeams.map(team => (
              <option
                value={team.id}
                selected={team.id === selectedTeamId}
              >
                {team.name}
              </option>
            ))}
          </select>

          <!-- Selected Team Preview - Enhanced -->
          <div id="team-preview" class={`mt-4 p-4 rounded-xl bg-orange-50 dark:bg-orange-500/10 border border-orange-200 dark:border-orange-500/30 ${selectedTeam ? '' : 'hidden'}`}>
            <div class="flex items-start gap-4">
              <img
                src={selectedTeam?.tokenImage || ''}
                alt={selectedTeam?.name || ''}
                class="w-16 h-16 rounded-xl object-cover ring-2 ring-orange-400 shadow-lg"
                id="preview-image"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h4 class="font-bold text-neutral-900 dark:text-white text-lg" id="preview-name">{selectedTeam?.name || ''}</h4>
                  <CheckCircle size={18} class="text-green-500 shrink-0" />
                </div>
                <p class="text-sm font-medium text-orange-600 dark:text-orange-400 mb-2" id="preview-project">{selectedTeam?.projectName || ''}</p>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3" id="preview-pitch">{selectedTeam?.elevatorPitch || ''}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Team Name (shown when creating own team) -->
        <div id="team-name-section" class={selectedTeam ? 'hidden' : ''}>
          <label for="team-name" class="block text-sm font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            Team Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            name="team-name"
            id="team-name"
            class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-white focus:border-purple-500 dark:focus:border-purple-400 focus:ring-4 focus:ring-purple-500/20 outline-none transition-all text-lg"
            placeholder="The Hot Yetis, Hungry Hippos, etc."
          />
          <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Get creative with it!</p>
        </div>

        <!-- Contact Info Section - Step 3 -->
        <div class="space-y-6 pt-4 border-t border-neutral-200 dark:border-neutral-700">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white">Your Contact Info</h3>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">Step 3 of 3</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-bold text-neutral-700 dark:text-neutral-200 mb-2">
                <Mail class="inline w-4 h-4 mr-1" />
                Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-white focus:border-orange-500 dark:focus:border-orange-400 focus:ring-4 focus:ring-orange-500/20 outline-none transition-all"
                placeholder="your@email.com"
              />
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">We'll send confirmation and updates here</p>
            </div>

            <div>
              <label for="phone" class="block text-sm font-bold text-neutral-700 dark:text-neutral-200 mb-2">
                <Phone class="inline w-4 h-4 mr-1" />
                Phone <span class="text-neutral-400">(optional)</span>
              </label>
              <input
                type="tel"
                name="phone"
                id="phone"
                class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-white focus:border-orange-500 dark:focus:border-orange-400 focus:ring-4 focus:ring-orange-500/20 outline-none transition-all"
                placeholder="(555) 123-4567"
              />
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">For day-of event coordination</p>
            </div>
          </div>
        </div>

        <!-- Team Members - Enhanced -->
        <div class="space-y-4">
          <div>
            <label for="team-members" class="block text-sm font-bold text-neutral-700 dark:text-neutral-200 mb-2">
              <Users class="inline w-4 h-4 mr-1" />
              Team Members <span class="text-red-500">*</span>
            </label>
            <textarea
              name="team-members"
              id="team-members"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-white focus:border-orange-500 dark:focus:border-orange-400 focus:ring-4 focus:ring-orange-500/20 outline-none transition-all resize-y font-mono text-sm"
              placeholder="Sarah Chen&#10;Marcus Johnson&#10;Priya Patel&#10;(add one name per line)"
            ></textarea>
          </div>
          <div class="flex flex-wrap gap-3">
            <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <CheckCircle size={14} class="text-green-500" />
              <span>Solo hackers welcome</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <CheckCircle size={14} class="text-green-500" />
              <span>Teams of any size</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <CheckCircle size={14} class="text-green-500" />
              <span>Add more later</span>
            </div>
          </div>
        </div>

        <!-- Project Idea (shown when creating own team) -->
        <div id="project-idea-section" class={selectedTeam ? 'hidden' : ''}>
          <label for="project-idea" class="block text-sm font-bold text-neutral-700 dark:text-neutral-200 mb-2">
            Your Idea (Elevator Pitch)
          </label>
          <textarea
            name="project-idea"
            id="project-idea"
            rows="4"
            class="w-full px-4 py-3 rounded-xl border-2 border-neutral-200 dark:border-neutral-600 bg-neutral-50 dark:bg-neutral-900 text-neutral-900 dark:text-white focus:border-purple-500 dark:focus:border-purple-400 focus:ring-4 focus:ring-purple-500/20 outline-none transition-all resize-y"
            placeholder="What problem are you solving? Who does it help? Don't worry if it's rough - that's what the hackathon is for!"
          ></textarea>
          <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Optional but helps us match you with mentors</p>
        </div>

        <!-- Submit Button - Enhanced -->
        <div class="pt-6 space-y-4">
          <button
            type="submit"
            id="submit-btn"
            class="w-full group relative overflow-hidden rounded-xl px-8 py-4 text-lg font-bold transition-all duration-300 hover:scale-[1.02] hover:shadow-xl hover:shadow-orange-500/30 active:scale-[0.98]"
          >
            <div class="absolute inset-0 bg-orange-500"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
            <span class="relative z-10 flex items-center justify-center gap-2 text-white">
              <span id="submit-text">Register My Team</span>
              <ChevronRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
            </span>
          </button>

          <!-- Trust Indicators -->
          <div class="flex flex-wrap justify-center gap-4 text-xs text-neutral-500 dark:text-neutral-400">
            <div class="flex items-center gap-1.5">
              <Shield size={14} class="text-green-500" />
              <span>Free to join</span>
            </div>
            <div class="flex items-center gap-1.5">
              <CheckCircle size={14} class="text-green-500" />
              <span>No credit card</span>
            </div>
            <div class="flex items-center gap-1.5">
              <Mail size={14} class="text-green-500" />
              <span>Instant confirmation</span>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- What Happens Next Section -->
    <div class="mt-10 p-6 rounded-2xl bg-neutral-100 dark:bg-neutral-800/50 border border-neutral-200 dark:border-neutral-700">
      <h3 class="font-bold text-neutral-900 dark:text-white mb-4 text-center">What happens after you register?</h3>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="flex items-start gap-3 p-3">
          <div class="shrink-0 w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold">1</div>
          <div>
            <p class="font-medium text-neutral-900 dark:text-white text-sm">Confirmation Email</p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">You'll get details about next steps within minutes</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3">
          <div class="shrink-0 w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold">2</div>
          <div>
            <p class="font-medium text-neutral-900 dark:text-white text-sm">Join Discord</p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">Connect with your team and other hackers</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3">
          <div class="shrink-0 w-8 h-8 rounded-full bg-orange-500 text-white flex items-center justify-center text-sm font-bold">3</div>
          <div>
            <p class="font-medium text-neutral-900 dark:text-white text-sm">Start Building</p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">Use AI tools, get mentor support, ship your project</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Info -->
    <div class="mt-8 text-center">
      <p class="text-neutral-600 dark:text-neutral-400">
        Questions? Email us at <a href="mailto:hello@vibecodeutah.com" class="font-semibold text-orange-600 dark:text-orange-400 hover:underline">hello@vibecodeutah.com</a>
      </p>
    </div>
  </div>
</MainLayout>

<script define:vars={{ teamsData: adoptableTeams }}>
  document.addEventListener('DOMContentLoaded', () => {
    const joinAdopt = document.getElementById('join-adopt');
    const joinCreate = document.getElementById('join-create');
    const adoptSelector = document.getElementById('adopt-selector');
    const teamNameSection = document.getElementById('team-name-section');
    const projectIdeaSection = document.getElementById('project-idea-section');
    const adoptTeamSelect = document.getElementById('adopt-team');
    const adoptedTeamIdInput = document.getElementById('adopted-team-id');
    const teamNameInput = document.getElementById('team-name');
    const optionCards = document.querySelectorAll('.team-option-card');
    const teamCardButtons = document.querySelectorAll('.team-card-select');
    const teamPreview = document.getElementById('team-preview');

    // Team data from server
    const teams = teamsData;

    function updateOptionCardStyles() {
      optionCards.forEach(card => {
        const radio = card.querySelector('input[type="radio"]');
        const isAdopt = radio.id === 'join-adopt';
        const checkDot = card.querySelector('.check-indicator div');

        if (radio.checked) {
          card.classList.remove('border-neutral-200', 'dark:border-neutral-600');
          card.classList.add(
            isAdopt ? 'border-orange-500' : 'border-neutral-300',
            isAdopt ? 'bg-orange-50' : 'bg-neutral-50',
            isAdopt ? 'dark:bg-orange-500/10' : 'dark:bg-neutral-700/50',
            isAdopt ? 'ring-2' : '',
            isAdopt ? 'ring-orange-500/20' : ''
          );
          checkDot.classList.add('scale-100');
          checkDot.classList.remove('scale-0');
        } else {
          card.classList.add('border-neutral-200', 'dark:border-neutral-600');
          card.classList.remove(
            'border-orange-500', 'border-neutral-300',
            'bg-orange-50', 'bg-neutral-50',
            'dark:bg-orange-500/10', 'dark:bg-neutral-700/50',
            'ring-2', 'ring-orange-500/20'
          );
          checkDot.classList.remove('scale-100');
          checkDot.classList.add('scale-0');
        }
      });
    }

    function showAdoptMode() {
      adoptSelector?.classList.remove('hidden');
      teamNameSection?.classList.add('hidden');
      projectIdeaSection?.classList.add('hidden');
      if (teamNameInput) teamNameInput.removeAttribute('required');
    }

    function showCreateMode() {
      adoptSelector?.classList.add('hidden');
      teamNameSection?.classList.remove('hidden');
      projectIdeaSection?.classList.remove('hidden');
      if (teamNameInput) teamNameInput.setAttribute('required', 'required');
      if (adoptedTeamIdInput) adoptedTeamIdInput.value = '';
      // Clear team card selections
      teamCardButtons.forEach(btn => {
        btn.classList.remove('border-orange-500', 'bg-orange-50', 'dark:bg-orange-500/10', 'ring-2', 'ring-orange-500/20');
        btn.classList.add('border-neutral-200', 'dark:border-neutral-600');
        const checkmark = btn.querySelector('.absolute.top-2');
        if (checkmark) {
          checkmark.classList.remove('bg-orange-500', 'text-white');
          checkmark.classList.add('bg-neutral-200', 'dark:bg-neutral-600', 'opacity-0');
        }
      });
      if (teamPreview) teamPreview.classList.add('hidden');
    }

    function selectTeamCard(teamId) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;

      // Update hidden select
      if (adoptTeamSelect) adoptTeamSelect.value = teamId;
      if (adoptedTeamIdInput) adoptedTeamIdInput.value = teamId;

      // Update card styles
      teamCardButtons.forEach(btn => {
        const btnTeamId = btn.dataset.teamId;
        const checkmark = btn.querySelector('.absolute.top-2');

        if (btnTeamId === teamId) {
          btn.classList.add('border-orange-500', 'bg-orange-50', 'dark:bg-orange-500/10', 'ring-2', 'ring-orange-500/20');
          btn.classList.remove('border-neutral-200', 'dark:border-neutral-600');
          if (checkmark) {
            checkmark.classList.add('bg-orange-500', 'text-white');
            checkmark.classList.remove('bg-neutral-200', 'dark:bg-neutral-600', 'opacity-0');
          }
        } else {
          btn.classList.remove('border-orange-500', 'bg-orange-50', 'dark:bg-orange-500/10', 'ring-2', 'ring-orange-500/20');
          btn.classList.add('border-neutral-200', 'dark:border-neutral-600');
          if (checkmark) {
            checkmark.classList.remove('bg-orange-500', 'text-white');
            checkmark.classList.add('bg-neutral-200', 'dark:bg-neutral-600', 'opacity-0');
          }
        }
      });

      // Update preview
      if (teamPreview) {
        teamPreview.classList.remove('hidden');
        const previewImage = document.getElementById('preview-image');
        const previewName = document.getElementById('preview-name');
        const previewProject = document.getElementById('preview-project');
        const previewPitch = document.getElementById('preview-pitch');

        if (previewImage) {
          previewImage.src = team.tokenImage;
          previewImage.alt = team.name;
        }
        if (previewName) previewName.textContent = team.name;
        if (previewProject) previewProject.textContent = team.projectName;
        if (previewPitch) previewPitch.textContent = team.elevatorPitch;
      }
    }

    // Event listeners for team cards
    teamCardButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const teamId = btn.dataset.teamId;
        selectTeamCard(teamId);
      });
    });

    // Event listeners for adopt/create toggle
    joinAdopt?.addEventListener('change', () => {
      showAdoptMode();
      updateOptionCardStyles();
    });

    joinCreate?.addEventListener('change', () => {
      showCreateMode();
      updateOptionCardStyles();
    });

    // Form submission - add loading state
    const form = document.getElementById('registration-form');
    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');

    form?.addEventListener('submit', () => {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
      }
      if (submitText) {
        submitText.textContent = 'Registering...';
      }
    });

    // Initialize styles
    updateOptionCardStyles();
  });
</script>

<style>
  .team-option-card {
    transition: all 0.3s ease;
  }

  .team-option-card:hover {
    transform: translateY(-2px);
  }

  .check-indicator div {
    transition: transform 0.2s ease;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Slow pulse animation for urgency badge */
  @keyframes pulse-slow {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
  }

  .animate-pulse-slow {
    animation: pulse-slow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* Team card selection animations */
  .team-card-select {
    transition: all 0.2s ease;
  }

  .team-card-select:hover {
    transform: translateY(-2px);
  }

  .team-card-select:active {
    transform: scale(0.98);
  }

  /* Form input focus animations */
  input:focus, textarea:focus, select:focus {
    transform: scale(1.01);
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Hero background pattern */
  .hero-bg-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgb(249 115 22 / 0.3) 1px, transparent 0);
    background-size: 40px 40px;
  }
</style>
